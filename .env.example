DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-33"

# Required for password reset / email verification to actually send.
RESEND_API_KEY=""
# Optional until a domain is verified in the Resend dashboard — until then
# Resend's shared sender can only deliver to the Resend account's own
# address, so this falls back to "C2C <onboarding@resend.dev>".
EMAIL_FROM=""

# Required for real payments — Connect + Checkout. See .agents/skills/stripe-best-practices.
STRIPE_SECRET_KEY=""
# Required once a webhook endpoint is added in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=""

# Optional — only needed for push notifications. Everything else works
# fine with these unset (sendPushToUser no-ops quietly if missing).
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional — set once a custom domain is attached. Falls back to Vercel's
# assigned *.vercel.app URL automatically, so this isn't required to deploy.
NEXT_PUBLIC_SITE_URL=""
