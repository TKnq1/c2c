DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-33"

# Required for password reset / email verification to actually send.
RESEND_API_KEY=""
# Production: "comtor <no-reply@comtor.app>" (comtor.app is verified in Resend).
# Leave empty locally: it falls back to Resend's shared sender, which only
# delivers to the Resend account's own address.
EMAIL_FROM=""
# Marketing mail from /admin/mailing stays off unless this is 1. Only turn it on for people who agreed to hear
# from comtor (see docs/legal-readiness.md). Open/click tracking is not recorded and must stay off in Resend.
OUTREACH_ENABLED=""

# Required for real payments — Connect + Checkout. See .agents/skills/stripe-best-practices.
STRIPE_SECRET_KEY=""
# Required once a webhook endpoint is added in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=""
# Required for the embedded Stripe Connect onboarding form (ConnectStripeButton)
# — the publishable key, safe to expose client-side. From the same Stripe
# dashboard page as STRIPE_SECRET_KEY (Developers → API keys).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# The recurring Price backing the Pro plan (€10/month, brands and creators) — create once with
# `stripe prices create --product <id> --unit-amount 1000 --currency eur
# -d "recurring[interval]=month"` (a Product must exist first). A separate
# live-mode Price is needed before switching STRIPE_SECRET_KEY to live.
STRIPE_PRO_PRICE_ID=""
# 1 turns on Stripe Tax for the Pro plan (VAT on Checkout and on every renewal, VAT IDs for businesses). Only set it
# after adding the head office address and an active registration in the Stripe Dashboard (Tax → Settings, Tax →
# Locations); the Price's tax behavior must be "inclusive" so customers still pay exactly €10.
STRIPE_AUTOMATIC_TAX=""

# Optional — only needed for push notifications. Everything else works
# fine with these unset (sendPushToUser no-ops quietly if missing).
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional — push in the store apps (see docs/store-release.md). Each channel
# no-ops quietly if its keys are missing, same as Web Push above.
# Android (FCM): the whole Firebase service-account JSON, on one line.
FIREBASE_SERVICE_ACCOUNT=""
# iOS (APNs): an Apple Push Notifications auth key (.p8) from the Apple
# Developer portal → Keys. Paste the .p8 contents with "\n" for newlines.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
# Defaults to app.comtor (capacitor.config.ts appId).
APNS_BUNDLE_ID=""
# "true" for TestFlight/App Store builds; unset for builds run from Xcode.
APNS_PRODUCTION=""

# Optional — set once a custom domain is attached. Falls back to Vercel's
# assigned *.vercel.app URL automatically, so this isn't required to deploy.
NEXT_PUBLIC_SITE_URL=""

# Pre-launch gate — see src/proxy.ts. Unset means the gate has no working
# bypass (GATE_ENABLED still has to be flipped off in code either way once
# launched).
GATE_BYPASS_SECRET=""

# Optional — error tracking (see src/instrumentation.ts). Everything works
# fine with this unset: no Sentry account is set up by this codebase, and
# nothing talks to Sentry until a real DSN is added here. A DSN isn't a
# secret (it's a write-only ingest endpoint), so the same value covers
# server, edge and client — no separate server-only var needed.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional — lets `next build` upload source maps so stack traces in Sentry
# show real code instead of minified output, and lets the admin dashboard
# (Technik) list the open errors of the last 24 hours at runtime, so set
# them for the running app as well. The dashboard only reads, so a token
# with read access is enough there. Needs an org/project created in the
# Sentry dashboard first.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Security (see docs/security-setup.md) ---
# Vercel Cron sends this as a bearer token to /api/cron/release-payments; without it the endpoint refuses everything.
CRON_SECRET=""
# Signing secret of the second Stripe webhook endpoint (v2 account events, /api/webhooks/stripe-account).
STRIPE_ACCOUNT_WEBHOOK_SECRET=""
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts new two-factor secrets at rest. Unset: stored as before.
TOTP_ENCRYPTION_KEY=""
# Any long random string. Keys the hash of two-factor recovery codes.
RECOVERY_CODE_PEPPER=""
# Own key for the outreach "stop these emails" links (falls back to AUTH_SECRET when unset).
OPT_OUT_SECRET=""
# Previews should NOT share the production database: point them at a Neon branch here (used when VERCEL_ENV=preview).
DATABASE_URL_PREVIEW=""
# Set to "0" only if verification emails can't be delivered: brands and creators otherwise need a verified email
# to post requests, message, make offers and pay.
REQUIRE_VERIFIED_EMAIL=""
# Admins need two-factor authentication to open /admin. "0" lifts that (for getting back in, not for keeping).
REQUIRE_ADMIN_2FA=""

# Shown in the imprint when set (§ 5 DDG): the VAT identification number, e.g. DE123456789.
IMPRINT_VAT_ID=""

# --- Brand deals (see docs/brand-deals.md) ---
# The switch for the whole feature. 1: an accepted offer becomes a deal and the briefing builder, the Deals screens and
# the Deals tab appear. Empty (the default, and what production should stay on until the contract model is settled with a
# lawyer and a tax adviser): everything works as before deals existed. Deals that already exist stay reachable either way.
# Fixed at build time on Vercel: a change takes a new deployment. Set it for Preview and Development, not for Production.
BRAND_DEALS_ENABLED=""
# Your own tax number, for the invoices and credit notes (§ 14 Abs. 4 Nr. 2 UStG). Alternative to IMPRINT_VAT_ID above:
# one of the two has to be set, otherwise no invoice is issued.
PLATFORM_TAX_NUMBER=""
# 1 if the operator itself is a small business (§ 19 UStG): then no VAT is charged to brands.
PLATFORM_SMALL_BUSINESS=""
# Signing secret for /api/webhooks/social (metrics / removal events for posts). Any long random string
# (openssl rand -base64 32). Unset: the endpoint refuses every delivery.
SOCIAL_WEBHOOK_SECRET=""
# Lets comtor ask Instagram whether a post still exists (oEmbed): "<app id>|<app secret>" of a Meta app with the
# oEmbed Read feature (needs Meta app review). Unset: Instagram posts are verified by a screenshot the brand confirms.
META_OEMBED_TOKEN=""
# YouTube Data API key (Google Cloud, YouTube Data API v3): adds views, likes and the description to the YouTube check.
# Unset: YouTube posts are still checked for existence through oEmbed.
YOUTUBE_API_KEY=""
