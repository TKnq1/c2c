generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STARTUP
  CREATOR
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  // Set when the password changes: sessions that began before it are
  // logged out at their next check (see the jwt callback in
  // src/lib/auth.ts), except keptSessionId, the one that made the change.
  sessionsRevokedAt DateTime?
  keptSessionId     String?
  role              Role
  emailVerified     Boolean   @default(false)
  // Encrypted at rest when TOTP_ENCRYPTION_KEY is set (see src/lib/secret-box.ts).
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  // The last 30-second step a code was accepted for, so one code can't be used twice.
  totpLastStep      Int?
  createdAt         DateTime  @default(now())
  // Set when the account was deleted but its payment records had to stay
  // (see deleteAccountAction): the person is anonymised, the rows are not.
  deletedAt         DateTime?

  // Proof of what was accepted at sign-up: when, and which version of the terms and privacy policy
  // (see src/lib/legal/version.ts). Null for accounts from before this was recorded.
  termsAcceptedAt DateTime?
  termsVersion    String?
  ageConfirmedAt  DateTime?

  // The optional "How did you hear about us?" answer at the end of onboarding: one of the codes in
  // src/lib/heard-from.ts, never free text.
  heardFrom String?

  // The ad campaign a sign-up came from, taken from the utm_* parameters of the link (see src/lib/utm.ts).
  // Plain text from a fixed set of characters, never anything the person typed. Null for organic sign-ups.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  adminPreference AdminPreference?

  // Set by an admin from /admin/users. A suspended account can't sign in,
  // and an existing session ends at its next periodic check (see auth.ts).
  suspendedAt     DateTime?
  suspendedReason String?

  // Access to /admin on top of the account's own role, so one email can be
  // a brand or creator and an admin at the same time. role ADMIN still
  // means an admin-only account (no profile, lands on /admin).
  isAdmin Boolean @default(false)

  // Per-category notification preferences (in-app + push) — default to on
  // so existing behavior doesn't change until someone opts out.
  notifyNewRequests Boolean @default(true)
  notifyNewInterest Boolean @default(true)
  notifyMessages    Boolean @default(true)
  notifyPayments    Boolean @default(true)
  notifyDeposits    Boolean @default(true)
  notifyNewCreators Boolean @default(true)

  // The language of the app itself. Separate from the content languages a
  // creator or a request uses for matching.
  locale String @default("en")

  // Optional product-news mail. Checking the box only sends a confirmation
  // link; marketingConsentAt is set when they press the button on that page
  // (mail scanners open links and must not count as a yes). The hash is what
  // we store, never the link itself.
  marketingConsentAt      DateTime?
  marketingTokenHash      String?   @unique
  marketingTokenExpiresAt DateTime?
  marketingSentAt         DateTime?

  startupProfile          StartupProfile?
  creatorProfile          CreatorProfile?
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  recoveryCodes           RecoveryCode[]
  loginAttempts           LoginAttempt[]
  nativePushTokens        NativePushToken[]
  reportsMade             Report[]                 @relation("ReportsMade")
  reportsReceived         Report[]                 @relation("ReportsReceived")
  blocksMade              Block[]                  @relation("BlocksMade")
  blocksReceived          Block[]                  @relation("BlocksReceived")
  pushSubscriptions       PushSubscription[]
  onboardingEvents        OnboardingEvent[]
  businessProfile         BusinessProfile?
  briefingTemplates       BriefingTemplate[]
}

// What happened at each step of the onboarding wizard, so /admin/onboarding
// can show where people drop out. One row per user, step and kind (see
// trackOnboardingEventAction), so it stays small and a reload can't count
// a step twice. "Dropped out" is a step that was viewed but never
// completed or skipped.
model OnboardingEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  step      String
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, step, kind])
  @@index([role, step, kind])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  // Null means system-generated (automated moderation), not filed by
  // another user — same queue, same review flow, just no human filer.
  reporterId String?
  reporter   User?        @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([reportedId])
  @@index([reporterId])
  @@index([status, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum NativePlatform {
  IOS
  ANDROID
}

// Device tokens from the Capacitor store apps — APNs tokens on iOS, FCM
// tokens on Android. Kept apart from PushSubscription (browser Web Push),
// which needs endpoint/p256dh/auth instead of a single token.
model NativePushToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  NativePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  succeeded Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
}

// One row per counted action of a rate-limited kind (see src/lib/rate-limit.ts).
// Old rows are deleted by the daily cron.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  key       String
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
  @@index([createdAt])
}

// Sessions that were logged out on purpose: the jwt callback checks the id
// at its periodic re-check (see src/lib/auth.ts). Rows can go once the
// session's own expiry has passed.
model RevokedSession {
  sid       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// Who did what from /admin, for every action that changes an account, a
// payment or sends mail to people.
model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetId])
  @@index([createdAt])
}

// No userId — a signup by definition doesn't have an account yet, so IP is
// the only key available to cap how many accounts one network can create.
model SignupAttempt {
  id        String   @id @default(cuid())
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// People who left their email on the landing page to hear when the iOS and
// Android apps are out. role is what they picked there, if anything.
model WaitlistEntry {
  id            String    @id @default(cuid())
  email         String    @unique
  role          Role?
  createdAt     DateTime  @default(now())
  // Double opt-in: the address gets a link first, and only confirmed
  // addresses get the launch email. confirmedAt is the proof of consent.
  confirmToken  String?   @unique
  confirmSentAt DateTime?
  confirmedAt   DateTime?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Only the SHA-256 of the token is stored (tokenHash); `token` is the old
  // plaintext column, emptied by a migration and no longer written.
  token     String?   @unique
  tokenHash String?   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Only the SHA-256 of the token is stored (tokenHash); `token` is the old
  // plaintext column, emptied by a migration and no longer written.
  token     String?   @unique
  tokenHash String?   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum NotificationCategory {
  newRequests
  newInterest
  newCreators
  messages
  payments
  deposits
}

model Notification {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  read      Boolean               @default(false)
  // Nullable so pre-existing rows from before this field don't need a
  // fabricated value. Set on every new notification going forward — lets
  // burst-prone categories (newRequests/newCreators/newInterest) find their
  // own most recent unread row to fold into instead of piling up one row
  // per event.
  category  NotificationCategory?
  count     Int                   @default(1)
  createdAt DateTime              @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, category, read])
}

model StartupProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  avatarUrl   String?
  website     String?
  niche       String?
  description String?
  lookingFor  String?
  createdAt   DateTime @default(now())

  // Pro subscription — a flat monthly fee for a reduced platform cut on
  // every payment (see PRO_PLATFORM_FEE_RATE). isPro/proSince are the
  // cheap, denormalized read of subscription state (kept in sync by the
  // webhook's customer.subscription.* handlers) so every fee calculation
  // doesn't need a live Stripe API call — stripeSubscriptionId is the
  // source of truth for actually managing the subscription itself.
  isPro                Boolean   @default(false)
  proSince             DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // The first brands (FOUNDING_BRAND_LIMIT) get Pro for as long as the account exists: number 1..N, no
  // subscription behind it. isPro is true for them too, so fees need no special case. A deleted account
  // gives its number back (see src/lib/founding.ts).
  foundingNumber       Int?      @unique
  // Set once a brand has been told about its founding Pro: for new brands when they get the place (the wizard
  // and the welcome mail say it), for brands that existed before from the admin's "send notice" (see
  // src/lib/founding-notice.ts). Null on a founding brand means: not told yet.
  foundingNoticeSentAt DateTime?

  requests       Request[]
  socialLinks    StartupSocialLink[]
  reviews        Review[]
  favorites      Favorite[]
  proWithdrawals ProWithdrawal[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

// A brand or a creator used the 14-day withdrawal on Pro. The money is
// already back with them; this row is what the admin list shows. Exactly
// one of startupId / creatorId is set.
model ProWithdrawal {
  id             String          @id @default(cuid())
  startupId      String?
  startup        StartupProfile? @relation(fields: [startupId], references: [id], onDelete: Cascade)
  creatorId      String?
  creator        CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  amountCents    Int
  stripeRefundId String?
  createdAt      DateTime        @default(now())

  @@index([createdAt])
}

model StartupSocialLink {
  id        String         @id @default(cuid())
  startupId String
  startup   StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  platform  String
  url       String

  @@unique([startupId, platform])
}

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  avatarUrl       String?
  // Up to MAX_CREATOR_NICHES (src/lib/constants.ts). Empty only until the
  // onboarding wizard's niche step. The Feed's "For you" shows requests in
  // these; "All" ignores them.
  niches          String[] @default([])
  // Deprecated: the first of `niches`, only still written (see
  // creatorNicheColumns) so the release before the multi-niche one keeps
  // working on this schema while a deploy rolls out. Nothing reads it; a
  // later migration drops it.
  niche           String   @default("")
  bio             String?
  contentLanguage String?
  createdAt       DateTime @default(now())

  // Stripe Connect (Accounts v2, express dashboard) — set once the creator
  // starts onboarding; stripeOnboarded flips true once Stripe confirms the
  // account can actually receive transfers (via the account.updated webhook),
  // not just once an account object exists.
  stripeAccountId String?
  stripeOnboarded Boolean @default(false)

  // Pro, the same plan brands have (see StartupProfile): a payment gets the
  // reduced fee when either side has it. stripeCustomerId is the Billing
  // customer for the subscription, not the Connect account above.
  isPro                Boolean   @default(false)
  proSince             DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // The first creators (FOUNDING_CREATOR_LIMIT) get Pro for as long as the account exists, numbered on their
  // own (creator no. 1 and brand no. 1 both exist). See src/lib/founding.ts.
  foundingNumber       Int?      @unique
  // Same as on StartupProfile: when the creator was told about the founding Pro.
  foundingNoticeSentAt DateTime?

  platforms      CreatorPlatform[]
  interests      Interest[]
  reviews        Review[]
  favoritedBy    Favorite[]
  passes         RequestPass[]
  proWithdrawals ProWithdrawal[]

  @@index([stripeAccountId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

// A creator swiping a request away in their Feed, so it doesn't come back
// on the next visit. Only the Feed reads this — it doesn't block anything
// else (the creator can still message the brand about that request from
// its profile). Undo deletes the row.
model RequestPass {
  id        String         @id @default(cuid())
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  requestId String
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([creatorId, requestId])
}

model Favorite {
  id              String         @id @default(cuid())
  startupId       String
  startup         StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Who did the favoriting — a startup and a creator can independently
  // favorite each other, so the same (startupId, creatorId) pair needs to
  // support two distinct rows rather than one shared one.
  favoritedByRole Role           @default(STARTUP)
  createdAt       DateTime       @default(now())

  @@unique([startupId, creatorId, favoritedByRole])
  @@index([creatorId])
}

model CreatorPlatform {
  id            String         @id @default(cuid())
  creatorId     String
  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform      String
  followerCount Int            @default(0)
  url           String?

  @@unique([creatorId, platform])
}

enum RequestStatus {
  OPEN
  CLOSED
  // Saved by the brand but not posted: only the brand sees it, nothing else counts it.
  DRAFT
}

model Request {
  id              String         @id @default(cuid())
  startupId       String
  startup         StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  title           String
  description     String
  // The single reference image from before requests had photos (a data
  // URI). Photos live in RequestImage now; this is only still read for
  // requests that never got any (see src/lib/request-photos.ts).
  imageUrl        String?
  niche           String
  // A creator matches if any one of these overlaps their content language —
  // e.g. a bilingual audience request lists both instead of picking one.
  languages       String[]       @default(["English"])
  minFollowers    Int            @default(0)
  productCategory String
  // What the brand pays, as a range in cents (equal for a fixed price).
  // Nullable only because older requests have none — the form requires it.
  budgetMinCents  Int?
  budgetMaxCents  Int?
  // Where it's posted and what, e.g. Instagram / "1 Reel + 2 Stories".
  platform        String?
  deliverables    String?
  // The day it should be live by; null means flexible.
  postBy          DateTime?      @db.Date
  productIncluded Boolean        @default(false)
  status          RequestStatus  @default(OPEN)
  // Closed by an admin (moderation): the brand can't reopen it itself.
  closedByAdmin   Boolean        @default(false)
  createdAt       DateTime       @default(now())

  images        RequestImage[]
  interests     Interest[]
  passes        RequestPass[]
  briefing      CampaignBriefing?
  briefingDraft BriefingDraft?

  @@index([startupId, createdAt])
  @@index([niche])
}

// A request's photos, in order — the first one is the cover on the card.
// Stored as bytes (there's no object storage yet) and served by
// /api/request-images/[id], so lists only ever carry the ids.
model RequestImage {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  position    Int
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([requestId, position])
}

enum PaymentStatus {
  OFFERED
  // Both sides agreed on a price; the brand still needs to complete Stripe
  // Checkout before anything is actually held. Real money only starts
  // existing once the webhook confirms payment and flips this to HELD.
  ACCEPTED
  HELD
  RELEASED
  REFUNDED
}

enum DepositStatus {
  REQUESTED
  HELD
  RELEASED
  FORFEITED
}

// One row per proposal in a chat. A counter doesn't overwrite the last
// amount: the previous row becomes SUPERSEDED and the new one is PENDING,
// so the thread can show the whole negotiation.
enum OfferEventOutcome {
  PENDING
  SUPERSEDED
  DECLINED
  WITHDRAWN
  ACCEPTED
}

model Interest {
  id          String         @id @default(cuid())
  requestId   String
  request     Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  // Who started this thread — a creator applying to an open request, or a
  // startup reaching out to a creator directly. Both paths create the same
  // Interest row, so without this, a startup messaging a creator makes that
  // creator look (to both sides) like they'd expressed interest on their
  // own — they hadn't. Drives how each side's UI describes/labels the row.
  initiatedBy Role           @default(CREATOR)

  amountCents          Int?
  platformFeeCents     Int?
  payoutCents          Int?
  paymentStatus        PaymentStatus?
  // Who made the current pending proposal (paymentStatus "OFFERED") — the
  // other role is the one who can accept/decline/counter it. Cleared
  // whenever an offer resolves (accepted, declined, or withdrawn).
  offerRole            Role?
  offeredAt            DateTime?
  // The version of the request's campaign briefing (CampaignBriefing.version, 0 = no briefing, the defaults) the proposer
  // made this offer under. Accepting is refused when the briefing has changed since: the contract is a copy of the
  // briefing at that moment, and nobody should accept terms they have not seen. Null = an offer from before deals.
  offerBriefingVersion Int?
  acceptedAt           DateTime?
  paidAt               DateTime?
  releasedAt           DateTime?
  refundedAt           DateTime?
  proofUrl             String?
  // The approval step between "posted" and "paid out" — paymentStatus stays
  // HELD throughout. The creator submits the link to their post
  // (proofSubmittedAt); the brand then approves it, which releases the
  // money right away, or reports a problem (disputedAt), which freezes it
  // until an admin releases or refunds it from /admin. No answer within
  // RELEASE_REVIEW_DAYS and it's released automatically (see
  // api/cron/release-payments).
  proofSubmittedAt     DateTime?
  disputedAt           DateTime?
  disputeReason        String?

  // Stripe identifiers for the real money movement behind this interest —
  // separate charges & transfers pattern (see src/lib/actions/payments.ts):
  // the checkout session charges the platform account, a later transfer
  // pays the creator's connected account out of that same charge.
  stripeCheckoutSessionId String? @unique
  stripeChargeId          String?
  stripeTransferId        String?
  stripeRefundId          String?

  // Refundable security deposit — for collabs where the brand ships a
  // physical product, so a creator can't just keep it without posting.
  // Independent of the cash payment above: a collab can have either, both,
  // or neither. No platform fee — it's fully refundable collateral, not
  // revenue, so the full amount always goes back to the creator or stays
  // with the brand, never split.
  depositCents       Int?
  depositStatus      DepositStatus?
  depositRequestedAt DateTime?
  depositPaidAt      DateTime?
  depositReleasedAt  DateTime?
  depositForfeitedAt DateTime?

  reviews     Review[]
  messages    Message[]
  offerEvents OfferEvent[]
  // The brand deal behind an accepted offer (briefing terms, drafts, posts, verification, payout gate).
  // Interests from before deals existed have none and keep the old approve/auto-release flow.
  deal        Deal?

  @@unique([requestId, creatorId])
  @@index([creatorId, paymentStatus])
  // The daily auto-release job's lookup: HELD payments past their review window.
  @@index([paymentStatus, proofSubmittedAt])
  @@index([creatorId, depositStatus])
}

model OfferEvent {
  id          String            @id @default(cuid())
  interestId  String
  interest    Interest          @relation(fields: [interestId], references: [id], onDelete: Cascade)
  role        Role
  amountCents Int
  payoutCents Int?
  outcome     OfferEventOutcome
  createdAt   DateTime          @default(now())

  @@index([interestId, createdAt])
}

model Message {
  id         String   @id @default(cuid())
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  senderRole Role
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([interestId, createdAt])
}

// Addresses an admin types in to send a marketing email. Two lists, one per
// side. Not tied to an account: the address is whatever they add.
enum OutreachSide {
  CREATOR
  STARTUP
}

model OutreachAddress {
  id          String             @id @default(cuid())
  name        String
  email       String
  side        OutreachSide
  createdAt   DateTime           @default(now())
  // How and when this person agreed to hear from comtor. Without it the address is never mailed.
  consentNote String?
  consentAt   DateTime?
  deliveries  OutreachDelivery[]

  @@unique([email, side])
  @@index([side, createdAt])
}

// One row per marketing email Resend accepted. Opens and clicks arrive later
// on the webhook and match this row by resendId.
// One press of Send. The people who got that mail stay here even if the
// address is later taken off the creator or brand list.
// Addresses that asked to stop (or were removed), as SHA-256 of the lower-case address, so nobody can add
// them again by mistake and the address itself isn't kept.
model OutreachSuppression {
  id        String   @id @default(cuid())
  emailHash String   @unique
  createdAt DateTime @default(now())
}

model OutreachMailing {
  id         String             @id @default(cuid())
  side       OutreachSide
  subject    String
  createdAt  DateTime           @default(now())
  deliveries OutreachDelivery[]

  @@index([createdAt])
}

model OutreachDelivery {
  id             String                  @id @default(cuid())
  mailingId      String
  mailing        OutreachMailing         @relation(fields: [mailingId], references: [id], onDelete: Cascade)
  addressId      String?
  address        OutreachAddress?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  recipientName  String
  recipientEmail String
  resendId       String                  @unique
  sentAt         DateTime                @default(now())
  openedAt       DateTime?
  clickedAt      DateTime?
  openCount      Int                     @default(0)
  clickCount     Int                     @default(0)
  events         OutreachDeliveryEvent[]

  @@index([addressId, sentAt])
  @@index([mailingId])
}

// The webhook id, so a retry does not count the same open or click twice.
model OutreachDeliveryEvent {
  id         String            @id
  deliveryId String
  delivery   OutreachDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  kind       OutreachEventKind
  createdAt  DateTime          @default(now())
}

enum OutreachEventKind {
  OPEN
  CLICK
}

model Review {
  id         String         @id @default(cuid())
  interestId String
  interest   Interest       @relation(fields: [interestId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  startupId  String
  startup    StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  authorRole Role
  rating     Int
  comment    String?
  createdAt  DateTime       @default(now())

  @@unique([interestId, authorRole])
  @@index([creatorId, authorRole])
  @@index([startupId, authorRole])
}

// What one admin has set up on the dashboard (see /admin/anpassen): the name in the greeting, accent colour,
// which tiles show, the goals and the morning start. One row per admin, created on first save.
model AdminPreference {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String?
  accent              String    @default("blue")
  compact             Boolean   @default(false)
  hiddenTiles         String[]  @default([])
  tileOrder           String[]  @default([])
  goalBrands          Int       @default(50)
  goalCreators        Int       @default(100)
  goalMonthlyFeeCents Int       @default(100000)
  morningEnabled      Boolean   @default(true)
  morningFromHour     Int       @default(5)
  morningToHour       Int       @default(11)
  morningEveryTime    Boolean   @default(false)
  songVolume          Int       @default(55)
  // No longer used: the Claude panel on the right of the admin pages is gone.
  panelOpen           Boolean   @default(false)
  // Which four figures stand at the top of Heute: one of the KPI_SETS in src/lib/admin-prefs.ts.
  kpiSet              String    @default("wachstum")
  // Which of the admin's reports also come by mail: the daily one, urgent notices, the weekly one.
  mailDaily           Boolean   @default(true)
  mailUrgent          Boolean   @default(true)
  mailWeekly          Boolean   @default(true)
  setupDoneAt         DateTime?
  updatedAt           DateTime  @updatedAt
}

enum AdminTaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum AdminTaskSource {
  CHECK
  CLAUDE
  MANUAL
}

enum AdminTaskStatus {
  OPEN
  DONE
  SNOOZED
}

// The "Offen" list on the admin dashboard. CHECK tasks are written by fixed checks against the data and close
// themselves when the cause is gone; CLAUDE tasks come from Claude's daily look at the numbers; MANUAL tasks are the
// admin's own. dedupeKey keeps a check or Claude from adding the same task twice.
model AdminTask {
  id           String            @id @default(cuid())
  title        String
  reason       String?
  priority     AdminTaskPriority @default(MEDIUM)
  source       AdminTaskSource
  status       AdminTaskStatus   @default(OPEN)
  href         String?
  dedupeKey    String?           @unique
  snoozedUntil DateTime?
  doneAt       DateTime?
  // A check task that closed itself because its cause went away (see planCheckSync): it reopens as soon as the cause is back.
  autoClosed   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, priority])
}

// The daily plan on "Heute": one row per routine ticked off, per admin and calendar day in Berlin
// (src/lib/admin-routines.ts). The checks in AdminTask are separate; these are the fixed habits.
model AdminRoutineCheck {
  id      String   @id @default(cuid())
  adminId String
  // "2026-10-08", the day in Europe/Berlin.
  day     String
  key     String
  doneAt  DateTime @default(now())

  @@unique([adminId, day, key])
  @@index([adminId, day])
}

// Business figures the admin types in. One row (id 1): the bank balance on a given day, which the cash view needs for
// the runway. Every change also leaves a CashSnapshot, so the balance has a history.
model AdminSettings {
  id               Int       @id @default(1)
  cashBalanceCents Int?
  cashBalanceAt    DateTime?
  updatedAt        DateTime  @updatedAt
}

model CashSnapshot {
  id           String   @id @default(cuid())
  balanceCents Int
  at           DateTime @default(now())

  @@index([at])
}

enum FixedCostInterval {
  MONTHLY
  YEARLY
}

// What the business pays regardless of sales (hosting, database, mail, domain, tools). Entered by hand.
model FixedCost {
  id          String            @id @default(cuid())
  name        String
  amountCents Int
  interval    FixedCostInterval @default(MONTHLY)
  note        String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
}

// One day of advertising on one channel and campaign, from a CSV export or typed in. campaignKey is the campaign name
// cleaned the way utm_campaign is (see src/lib/utm.ts), which is how a sign-up is matched to the money spent on it.
model AdSpend {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  channel      String
  campaignKey  String
  campaignName String
  spendCents   Int
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  source       String
  createdAt    DateTime @default(now())

  @@unique([day, channel, campaignKey])
  @@index([day])
}

// One row per email the app tried to send: what it was and whether the mail service accepted it. The address is not
// kept. Rows older than 120 days are deleted when the dashboard refreshes its figures.
model MailLog {
  id        String   @id @default(cuid())
  subject   String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum ProEventKind {
  STARTED
  ENDED
}

// A paid Pro subscription starting or ending, from the Stripe webhook. History starts the day this shipped.
model ProEvent {
  id        String       @id @default(cuid())
  kind      ProEventKind
  side      Role
  profileId String
  at        DateTime     @default(now())

  @@index([at])
}

// The decisions behind the product, so "why did we do it this way" has an answer later.
model DecisionLog {
  id        String   @id @default(cuid())
  decidedOn DateTime @db.Date
  title     String
  decision  String
  reason    String?
  createdAt DateTime @default(now())

  @@index([decidedOn])
}

// The last answer of an outside service (Sentry, Stripe), so the admin pages and the fixed checks don't call out on every
// page view. Refreshed in the background when older than a few minutes.
model ExternalSnapshot {
  key       String   @id
  data      Json
  fetchedAt DateTime
}

enum AdminNoticeKind {
  DAILY
  WEEKLY
  URGENT
}

// The admin dashboard's own inbox. A report or notice is written once (dedupeKey keeps a retry from writing it twice),
// shown in the dashboard and, per admin and kind, mailed. readAt is shared: this is one inbox for the admin team.
model AdminNotice {
  id        String          @id @default(cuid())
  kind      AdminNoticeKind
  title     String
  // Plain text, one line per row; sections are separated by an empty line.
  body      String
  href      String?
  dedupeKey String?         @unique
  readAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([createdAt])
  @@index([readAt])
}

// Visits to the landing and sign-up pages, counted per day, page and origin (see src/lib/visit-count.ts). It holds no
// cookie, no address, no browser string and nothing that identifies a visitor.
model PageView {
  id       String   @id @default(cuid())
  day      DateTime @db.Date
  page     String
  // utm_source if the link had one, else the referring site's name, else "direkt"; "intern" for our own pages.
  source   String
  campaign String   @default("")
  views    Int      @default(0)

  @@unique([day, page, source, campaign])
  @@index([day])
}

// ---------------------------------------------------------------------------------------------------------------------
// Brand deals: the campaign workflow that sits on top of an accepted offer (Interest). The money (escrow, transfer,
// refund) stays on the Interest row; the Deal decides *when* it may move: only after the post is verified live and the
// hold window has run out (see src/lib/deals/status.ts and payment-release.ts).
// ---------------------------------------------------------------------------------------------------------------------

enum DealStatus {
  // Terms are frozen, both sides still have to confirm them.
  CONTRACT_PENDING
  // Both confirmed; the brand has to fund the escrow (Stripe Checkout, net price + VAT).
  AWAITING_ESCROW
  // Escrow funded; the creator produces the content.
  IN_PRODUCTION
  DRAFT_SUBMITTED
  CHANGES_REQUESTED
  DRAFT_APPROVED
  POST_SCHEDULED
  // The creator handed in the live link / proof; waiting for the first verification.
  POST_SUBMITTED
  // Verified live; the hold window (minLiveHours) is running.
  VERIFYING
  // The post disappeared during the window; the creator has a grace period to publish it again.
  REPOST_REQUIRED
  // Window over, post still live: the payout is released (or retried).
  PAYOUT_PENDING
  COMPLETED
  // Frozen for an admin decision (see DealDispute).
  DISPUTED
  CANCELLED
}

enum DealDraftKind {
  SCRIPT
  VIDEO_PREVIEW
  IMAGE
  OTHER
}

enum DealDraftStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum UsageRightsType {
  // Posting on the creator's own channel only.
  ORGANIC_ONLY
  // The brand may repost it on its own channels (no paid promotion), for a limited time.
  CROSS_POST
  // Paid use: Meta Partnership Ads, TikTok Spark Ads, whitelisting. Needs a duration and a fee.
  PAID_ADS
}

enum PostVerificationStatus {
  PENDING
  VERIFIED
  REMOVED
  // The platform could not be asked (no token, outage). Counted as "not yet known", never as "gone".
  UNREACHABLE
  REJECTED
}

enum PostVerificationSource {
  MANUAL
  OEMBED
  API
  WEBHOOK
  PROOF
}

enum DealProofKind {
  SCREENSHOT
  ANALYTICS
}

enum DisputeReason {
  MISSED_DEADLINE
  DRAFT_REJECTED
  POST_REMOVED
  DISCLOSURE_MISSING
  CONTENT_MISMATCH
  USAGE_RIGHTS_MISSING
  OTHER
  // The brand's bank took the payment back (a Stripe dispute); only the system opens one with this reason.
  CHARGEBACK
}

enum DisputeStatus {
  OPEN
  RESOLVED_RELEASE
  RESOLVED_REFUND
  RESOLVED_RESUME
}

enum TaxTreatment {
  // German VAT charged.
  DOMESTIC_VAT
  // Business in another EU state with a valid VAT ID: the recipient accounts for the VAT (Art. 196 VAT Directive).
  REVERSE_CHARGE_EU
  // Supplier outside the EU, German recipient accounts for the VAT (§ 13b UStG).
  REVERSE_CHARGE_13B
  // Service not taxable in Germany (recipient outside the EU).
  OUT_OF_SCOPE
  // Small-business exemption (§ 19 UStG or the EU SME scheme): no VAT shown.
  SMALL_BUSINESS_EXEMPT
}

enum InvoiceKind {
  // Platform to brand.
  BRAND_INVOICE
  // Self-billing credit note: the platform bills on the creator's behalf (§ 14 Abs. 2 UStG).
  CREATOR_CREDIT_NOTE
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

enum VatIdStatus {
  UNCHECKED
  VALID
  INVALID
  // VIES or the member state's service was down: try again later, the status is not a verdict.
  UNAVAILABLE
}

// What a brand wrote down for a request beyond title and budget: the rules of the campaign. Editable until a deal
// exists; the deal takes a frozen copy (Deal.terms).
model CampaignBriefing {
  id        String  @id @default(cuid())
  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Goes up by one whenever a save changes the rules (a save that changes nothing leaves it). Offers are made under a
  // version, see Interest.offerBriefingVersion.
  version   Int     @default(1)

  // Where the ad is shown to people: decides which disclosure labels count (DE, AT, CH, FR, ...).
  targetMarket     String   @default("DE")
  // PostFormat codes (src/lib/social/platforms.ts), e.g. INSTAGRAM_REEL, TIKTOK_VIDEO.
  contentFormats   String[] @default([])
  talkingPoints    String?
  doNots           String?
  requiredHashtags String[] @default([])
  requiredMentions String[] @default([])

  // Advertising disclosure (UWG § 5a Abs. 4, MStV § 8, DDG § 6): the wording the creator must use, and whether the
  // platform's own paid-partnership label is required on top.
  disclosureLabels            String[] @default([])
  requirePaidPartnershipLabel Boolean  @default(true)

  // Workflow
  draftRequired          Boolean   @default(true)
  draftDueDaysBeforePost Int       @default(5)
  brandReviewDays        Int       @default(3)
  maxRevisionRounds      Int       @default(2)
  postingWindowStart     DateTime? @db.Date
  postingWindowEnd       DateTime? @db.Date
  // The post has to stay live this long after it was first verified; the payout waits for it.
  minLiveHours           Int       @default(24)

  // Exclusivity: no competing brand N days before / after publication.
  exclusivityEnabled     Boolean  @default(false)
  exclusivityCategories  String[] @default([])
  exclusivityCompetitors String[] @default([])
  exclusivityDaysBefore  Int      @default(0)
  exclusivityDaysAfter   Int      @default(0)

  // Usage rights beyond the creator's own channel.
  usageType         UsageRightsType @default(ORGANIC_ONLY)
  // UsageChannel codes (src/lib/compliance/usage-rights.ts)
  usageChannels     String[]        @default([])
  usageDurationDays Int?
  // The part of the price that pays for the usage rights (it is inside the offer amount, shown as its own invoice line).
  usageFeeCents     Int?
  usageTerritory    String          @default("EU")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A brand's saved briefing: a starting point for the briefing of a request. A copy, not a link: changing a template
// later changes no request and no deal.
model BriefingTemplate {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // The briefing builder's field values (src/lib/compliance/briefing-form.ts) without the posting window, which belongs
  // to a request. Read back with parseBriefingForm, so a field added later falls back to its default.
  values     Json
  // The one the brand's new requests start from (at most one per brand, kept in code).
  isDefault  Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

// A briefing the brand started and has not finished (it still has errors). It is not active: the request keeps the
// briefing it had, or the defaults, until a save without errors replaces it.
model BriefingDraft {
  id        String   @id @default(cuid())
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id                  String      @id @default(cuid())
  interestId          String      @unique
  interest            Interest    @relation(fields: [interestId], references: [id], onDelete: Cascade)
  // Denormalised so exclusivity and listings do not have to join through the request.
  startupId           String
  creatorId           String
  status              DealStatus  @default(CONTRACT_PENDING)
  // Where the deal was before a dispute froze it, for "resume".
  statusBeforeDispute DealStatus?
  statusChangedAt     DateTime    @default(now())

  // The frozen terms (DealTerms, src/lib/deals/terms.ts) and their SHA-256: what both sides confirmed.
  terms           Json
  termsHash       String
  brandSignedAt   DateTime?
  brandSignedBy   String?
  creatorSignedAt DateTime?
  creatorSignedBy String?

  // Deadlines (computed when the escrow is funded, see src/lib/deals/deadlines.ts)
  fundedAt         DateTime?
  draftDueAt       DateTime?
  draftReviewDueAt DateTime?
  revisionDueAt    DateTime?
  revisionRound    Int       @default(0)
  postWindowStart  DateTime?
  postWindowEnd    DateTime?
  scheduledFor     DateTime?
  // End of the grace period of whatever is overdue (post date, revision) or of a removed post.
  graceUntil       DateTime?
  // Reminders already sent, so the daily job does not repeat them: "draft_due", "post_due", ...
  remindersSent    String[]  @default([])

  // Verification and payout gate
  firstLiveAt        DateTime?
  verificationEndsAt DateTime?
  payoutEligibleAt   DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?

  // Usage rights actually handed over (Spark Ads code, partnership-ad permission) and when they lapse.
  usageDeliveredAt      DateTime?
  usageConfirmedAt      DateTime?
  usageStartsAt         DateTime?
  usageExpiresAt        DateTime?
  sparkAdsCode          String?
  sparkAdsCodeExpiresAt DateTime?
  usageExpiryNoticeAt   DateTime?

  // Tax, fixed when the escrow is created (src/lib/tax/engine.ts). What the brand pays is brandTotalCents; the
  // creator's payout stays Interest.payoutCents, VAT included where the creator charges it.
  taxSnapshot     Json?
  brandNetCents   Int?
  brandVatCents   Int?
  brandTotalCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts   DealDraft[]
  posts    DealPost[]
  events   DealEvent[]
  disputes DealDispute[]
  invoices Invoice[]

  @@index([status, statusChangedAt])
  @@index([creatorId, status])
  @@index([startupId, status])
}

model DealDraft {
  id                  String          @id @default(cuid())
  dealId              String
  deal                Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  version             Int
  kind                DealDraftKind
  // A link to the script / preview (Google Drive, Frame.io, unlisted YouTube, ...).
  url                 String?
  notes               String?
  // The caption the creator plans to use: checked against the disclosure rules before the brand even sees it.
  caption             String?
  disclosureConfirmed Boolean         @default(false)
  status              DealDraftStatus @default(SUBMITTED)
  feedback            String?
  autoApproved        Boolean         @default(false)
  submittedAt         DateTime        @default(now())
  reviewedAt          DateTime?

  @@unique([dealId, version])
}

model DealPost {
  id                   String                 @id @default(cuid())
  dealId               String
  deal                 Deal                   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // PostFormat code (src/lib/social/platforms.ts)
  format               String
  url                  String?
  externalId           String?
  status               PostVerificationStatus @default(PENDING)
  source               PostVerificationSource @default(MANUAL)
  caption              String?
  // Which wording the creator used ("Werbung", "Anzeige", ...), whether the platform's label is switched on, and
  // whether the content itself (spoken / on screen) says it is an ad.
  disclosureLabel      String?
  paidPartnershipLabel Boolean                @default(false)
  disclosureInContent  Boolean                @default(false)
  hashtagsFound        String[]               @default([])
  scheduledFor         DateTime?
  publishedAt          DateTime?
  submittedAt          DateTime               @default(now())
  lastCheckedAt        DateTime?
  verifiedAt           DateTime?
  removedAt            DateTime?
  // Failed checks in a row; one failure is a hiccup, removalConfirmFailures of them are a removal.
  checkFailures        Int                    @default(0)
  // Brand confirmation for formats that cannot be checked by link (Stories).
  brandConfirmedAt     DateTime?
  note                 String?

  proofs  DealProof[]
  metrics DealPostMetric[]

  @@index([dealId])
  @@index([status, lastCheckedAt])
  @@index([externalId])
}

// A screenshot / analytics image as bytes (there is no object storage yet, same as RequestImage), served by
// /api/deals/[id]/proofs/[proofId] to the two participants and admins only.
model DealProof {
  id          String        @id @default(cuid())
  postId      String
  post        DealPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind        DealProofKind @default(SCREENSHOT)
  contentType String
  sha256      String
  // Emptied (zero bytes) when the retention period after the end of the deal is over; the row and the hash stay as the record that
  // there was one (src/lib/deals/retention.ts).
  data        Bytes
  createdAt   DateTime      @default(now())
  purgedAt    DateTime?

  @@index([postId])
}

model DealPostMetric {
  id         String   @id @default(cuid())
  postId     String
  post       DealPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now())
  views      Int?
  likes      Int?
  comments   Int?
  shares     Int?
  source     String
  // The provider's event id, so a webhook retry does not store the same reading twice.
  eventId    String?  @unique

  @@index([postId, capturedAt])
}

// The trail of a deal: every status change and every automatic action, with who did it.
model DealEvent {
  id          String      @id @default(cuid())
  dealId      String
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind        String
  fromStatus  DealStatus?
  toStatus    DealStatus?
  // Null: the system (webhook, daily job).
  actorRole   Role?
  actorUserId String?
  data        Json?
  createdAt   DateTime    @default(now())

  @@index([dealId, createdAt])
}

model DealDispute {
  id                String        @id @default(cuid())
  dealId            String
  deal              Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reason            DisputeReason
  details           String?
  // Null: opened by the system (missed deadline, removed post, ...).
  openedByRole      Role?
  openedByUserId    String?
  // Stripe's id of the chargeback this dispute stands for (dp_...), so a repeated or closing event finds it again.
  stripeDisputeId   String?       @unique
  status            DisputeStatus @default(OPEN)
  resolution        String?
  resolvedByAdminId String?
  openedAt          DateTime      @default(now())
  resolvedAt        DateTime?

  @@index([dealId])
  @@index([status, openedAt])
}

// Trader data for brands and creators: who is behind the account, taxed how, and what they confirmed (DSA Art. 30 /
// P2B Regulation transparency, VAT invoicing). One row per user.
model BusinessProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  legalName      String
  // COMPANY, SOLE_PROPRIETOR or FREELANCER (src/lib/tax/business.ts). Private persons cannot use deals.
  businessType   String
  country        String
  addressLine1   String
  addressLine2   String?
  postalCode     String
  city           String
  phone          String?
  registerNumber String?

  taxNumber               String?
  vatId                   String?
  vatIdStatus             VatIdStatus @default(UNCHECKED)
  vatIdCheckedAt          DateTime?
  // The VIES consultation number (requestIdentifier): proof of the check for the tax authorities.
  vatIdConsultationNumber String?
  vatIdRegisteredName     String?
  vatIdRegisteredAddress  String?
  // § 19 UStG (DE) or the small-business scheme of the member state: no VAT is charged.
  smallBusinessExempt     Boolean     @default(false)

  // "I act exclusively for my trade, business or profession" (DSA Art. 30(1)(g)).
  traderSelfCertifiedAt DateTime?
  traderCertVersion     String?
  // Agreement that the platform issues credit notes in the creator's name (§ 14 Abs. 2 UStG). Creators only.
  selfBillingAcceptedAt DateTime?
  selfBillingVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vatId])
}

model Invoice {
  id                 String        @id @default(cuid())
  number             String        @unique
  kind               InvoiceKind
  status             InvoiceStatus @default(ISSUED)
  dealId             String
  deal               Deal          @relation(fields: [dealId], references: [id], onDelete: Restrict)
  // Who receives the document (the brand for an invoice, the creator for a credit note). No relation on purpose:
  // an invoice outlives the account (§ 147 AO), see account-deletion.ts.
  recipientUserId    String
  currency           String        @default("EUR")
  issuedAt           DateTime      @default(now())
  servicePeriodStart DateTime?
  servicePeriodEnd   DateTime?
  netCents           Int
  vatCents           Int
  grossCents         Int
  vatRateBp          Int
  taxTreatment       TaxTreatment
  legalNote          String?
  // Issuer, recipient and lines exactly as printed: later profile changes never rewrite an issued invoice.
  issuer             Json
  recipient          Json
  lines              Json
  // 0: the document as it was first issued. A correction is two documents (src/lib/billing/correct.ts): a cancellation, which
  // repeats the original with every amount negated and points at it (cancelsInvoiceId), and a new document that replaces
  // it. Each gets the next revision of its deal and kind; all of them take their number from the same gapless series.
  revision           Int           @default(0)
  cancelsInvoiceId   String?       @unique
  cancels            Invoice?      @relation("InvoiceCancellation", fields: [cancelsInvoiceId], references: [id], onDelete: Restrict)
  cancelledBy        Invoice?      @relation("InvoiceCancellation")
  // Set on the original when it was cancelled, with the reason that was written down.
  cancelledAt        DateTime?
  cancelReason       String?

  @@unique([dealId, kind, revision])
  @@index([recipientUserId, issuedAt])
}

// Gapless numbering per kind and year ("RE-2026-000001"): the counter is incremented in the same transaction that
// writes the invoice, so a rolled-back invoice gives its number back.
model InvoiceSequence {
  key        String @id
  lastNumber Int    @default(0)
}
