generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STARTUP
  CREATOR
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role
  emailVerified Boolean  @default(false)
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Per-category notification preferences (in-app + push) — default to on
  // so existing behavior doesn't change until someone opts out.
  notifyNewRequests Boolean @default(true)
  notifyNewInterest Boolean @default(true)
  notifyMessages    Boolean @default(true)
  notifyPayments    Boolean @default(true)
  notifyDeposits    Boolean @default(true)
  notifyNewCreators Boolean @default(true)

  startupProfile          StartupProfile?
  creatorProfile          CreatorProfile?
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  recoveryCodes           RecoveryCode[]
  loginAttempts           LoginAttempt[]
  reportsMade             Report[]                 @relation("ReportsMade")
  reportsReceived         Report[]                 @relation("ReportsReceived")
  blocksMade              Block[]                  @relation("BlocksMade")
  blocksReceived          Block[]                  @relation("BlocksReceived")
  pushSubscriptions       PushSubscription[]
  savedFilters            SavedFilter[]
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  // Null means system-generated (automated moderation), not filed by
  // another user — same queue, same review flow, just no human filer.
  reporterId String?
  reporter   User?        @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([reportedId])
  @@index([reporterId])
  @@index([status, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  succeeded Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum NotificationCategory {
  newRequests
  newInterest
  newCreators
  messages
  payments
  deposits
}

model Notification {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  read      Boolean               @default(false)
  // Nullable so pre-existing rows from before this field don't need a
  // fabricated value. Set on every new notification going forward — lets
  // burst-prone categories (newRequests/newCreators/newInterest) find their
  // own most recent unread row to fold into instead of piling up one row
  // per event.
  category  NotificationCategory?
  count     Int                   @default(1)
  createdAt DateTime              @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, category, read])
}

model StartupProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  avatarUrl   String?
  website     String?
  niche       String?
  description String?
  lookingFor  String?
  createdAt   DateTime @default(now())

  // Simulated Pro subscription — a flat monthly fee for a reduced platform
  // cut on every payment (see PRO_PLATFORM_FEE_RATE). No real recurring
  // billing runs here (that needs Stripe); it's a plain on/off toggle
  // rather than a fake auto-renewal we can't actually enforce.
  isPro    Boolean   @default(false)
  proSince DateTime?

  requests    Request[]
  socialLinks StartupSocialLink[]
  reviews     Review[]
  favorites   Favorite[]
}

model StartupSocialLink {
  id        String         @id @default(cuid())
  startupId String
  startup   StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  platform  String
  url       String

  @@unique([startupId, platform])
}

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  avatarUrl       String?
  niche           String
  bio             String?
  contentLanguage String?
  createdAt       DateTime @default(now())

  platforms   CreatorPlatform[]
  interests   Interest[]
  reviews     Review[]
  favoritedBy Favorite[]
}

model Favorite {
  id              String         @id @default(cuid())
  startupId       String
  startup         StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Who did the favoriting — a startup and a creator can independently
  // favorite each other, so the same (startupId, creatorId) pair needs to
  // support two distinct rows rather than one shared one.
  favoritedByRole Role           @default(STARTUP)
  createdAt       DateTime       @default(now())

  @@unique([startupId, creatorId, favoritedByRole])
  @@index([creatorId])
}

model CreatorPlatform {
  id            String         @id @default(cuid())
  creatorId     String
  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform      String
  followerCount Int            @default(0)
  url           String?

  @@unique([creatorId, platform])
}

enum RequestStatus {
  OPEN
  CLOSED
}

model Request {
  id              String         @id @default(cuid())
  startupId       String
  startup         StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  title           String
  description     String
  niche           String
  language        String         @default("English")
  minFollowers    Int            @default(0)
  productCategory String
  status          RequestStatus  @default(OPEN)
  createdAt       DateTime       @default(now())

  interests Interest[]

  @@index([startupId, createdAt])
  @@index([niche])
}

enum PaymentStatus {
  OFFERED
  HELD
  RELEASED
  REFUNDED
}

enum DepositStatus {
  REQUESTED
  HELD
  RELEASED
  FORFEITED
}

model Interest {
  id        String         @id @default(cuid())
  requestId String
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  amountCents      Int?
  platformFeeCents Int?
  payoutCents      Int?
  paymentStatus    PaymentStatus?
  // Who made the current pending proposal (paymentStatus "OFFERED") — the
  // other role is the one who can accept/decline/counter it. Cleared
  // whenever an offer resolves (accepted, declined, or withdrawn).
  offerRole        Role?
  offeredAt        DateTime?
  paidAt           DateTime?
  releasedAt       DateTime?
  refundedAt       DateTime?
  proofUrl         String?

  // Refundable security deposit — for collabs where the brand ships a
  // physical product, so a creator can't just keep it without posting.
  // Independent of the cash payment above: a collab can have either, both,
  // or neither. No platform fee — it's fully refundable collateral, not
  // revenue, so the full amount always goes back to the creator or stays
  // with the brand, never split.
  depositCents       Int?
  depositStatus      DepositStatus?
  depositRequestedAt DateTime?
  depositPaidAt      DateTime?
  depositReleasedAt  DateTime?
  depositForfeitedAt DateTime?

  reviews  Review[]
  messages Message[]

  @@unique([requestId, creatorId])
  @@index([creatorId, paymentStatus])
  @@index([creatorId, depositStatus])
}

model Message {
  id         String   @id @default(cuid())
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  senderRole Role
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([interestId, createdAt])
}

model Review {
  id         String         @id @default(cuid())
  interestId String
  interest   Interest       @relation(fields: [interestId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  startupId  String
  startup    StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  authorRole Role
  rating     Int
  comment    String?
  createdAt  DateTime       @default(now())

  @@unique([interestId, authorRole])
  @@index([creatorId, authorRole])
  @@index([startupId, authorRole])
}

// A saved filter combination for a Discover-style page — scope identifies
// which page it applies to, query is the raw querystring (e.g.
// "niche=Fitness,Lifestyle&platform=TikTok") so applying it is just a
// navigation, no separate parsing/rebuilding logic needed.
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  name      String
  query     String
  createdAt DateTime @default(now())

  @@index([userId, scope])
}
